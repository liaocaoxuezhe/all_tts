# ALLTTS 配置模板（UTF-8）
# 复制为 .env，只填写要使用的厂商；空值表示尚未配置。
# cp .env.example .env
# chmod 600 .env
# 客户端不会自动加载 .env，请在执行客户端的同一终端中运行：
# set -a
# source .env
# set +a
# .venv/bin/python skills/alltts/scripts/alltts.py voices --provider openai
# 密钥使用单引号包裹；不要把真实密钥填写到本示例文件。

# 火山 / 豆包：新版 API Key，不是旧版 AppId / Access Token。
VOLCENGINE_API_KEY='' # 本机填写，模板留空

# MiniMax：cn 为中国站，global 为国际站；区域须与账号密钥匹配。
MINIMAX_API_KEY='' # 本机填写，模板留空
MINIMAX_REGION='cn'

# Gemini Developer API：与下方 Google Cloud TTS 凭据不同。
GEMINI_API_KEY='' # 本机填写，模板留空

# 阿里百炼 Qwen-TTS：cn 为北京，intl 为新加坡。
DASHSCOPE_API_KEY='' # 本机填写，模板留空
DASHSCOPE_REGION='cn'

# 腾讯云：SecretId / SecretKey 必填；区域与临时会话 Token 可选。
TENCENT_SECRET_ID='' # 本机填写，模板留空
TENCENT_SECRET_KEY='' # 本机填写，模板留空
TENCENT_REGION='' # 本机填写，模板留空
TENCENT_TOKEN='' # 本机填写，模板留空

# Azure Speech：Key 与资源 Region 必填且配套，例如 eastasia。
AZURE_SPEECH_KEY='' # 本机填写，模板留空
AZURE_SPEECH_REGION='' # 本机填写，模板留空

# ElevenLabs：音色 ID 通过账号实时目录查询，再使用 --voice 指定。
ELEVENLABS_API_KEY='' # 本机填写，模板留空

# OpenAI Speech
OPENAI_API_KEY='' # 本机填写，模板留空

# Fish Audio：音色 reference_id 通过工作空间目录查询。
FISH_API_KEY='' # 本机填写，模板留空

# 科大讯飞：在线语音合成（流式版）产品的三项凭据均必填。
# 使用控制台已开通的精确 vcn；运行时需 websocket-client。
XFYUN_APP_ID='' # 本机填写，模板留空
XFYUN_API_KEY='' # 本机填写，模板留空
XFYUN_API_SECRET='' # 本机填写，模板留空

# Google Cloud TTS：OAuth 访问令牌，需有 cloud-platform 权限。
# GOOGLE_QUOTA_PROJECT 可选；访问令牌过期后需自行更新。
GOOGLE_ACCESS_TOKEN='' # 本机填写，模板留空
GOOGLE_QUOTA_PROJECT='' # 本机填写，模板留空

# AWS Polly：访问凭据与区域必填，例如 us-east-1；运行时需 boto3。
# 临时凭据还须填写 AWS_SESSION_TOKEN；音色 / engine 必须适配区域。
AWS_ACCESS_KEY_ID='' # 本机填写，模板留空
AWS_SECRET_ACCESS_KEY='' # 本机填写，模板留空
AWS_REGION='' # 本机填写，模板留空
AWS_SESSION_TOKEN='' # 本机填写，模板留空

# 百度短文本 TTS：客户端使用两项凭据交换 access_token。
BAIDU_API_KEY='' # 本机填写，模板留空
BAIDU_SECRET_KEY='' # 本机填写，模板留空

# Cartesia：客户端固定 API 版本；音色 ID 通过账号目录查询。
CARTESIA_API_KEY='' # 本机填写，模板留空

# 本机系统语音无需 API Key。
# 模型、音色、语言及语速用 CLI 参数指定，详见：
# skills/alltts/references/usage.md
